<launch>
  <arg name="world" default="$(find-pkg-share k9_robot_bringup)/worlds/empty_world.sdf"/>
  <arg name="rviz" default="true"/>
  <arg name="gui" default="true"/>
  <include file="$(find-pkg-share k9_robot_bringup)/launch/k9_robot_gazebo.launch.py">
    <arg name="world" value="$(var world)"/>
    <arg name="rviz" value="$(var rviz)"/>
    <arg name="gui" value="$(var gui)"/>
  </include>
</launch>
